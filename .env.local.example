# Copy to `.env.local`.
# Base URL of the FastAPI backend. Leave as-is for local development; the
# Next.js rewrite in next.config.mjs proxies /api/v1/* to this host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Poll interval (ms) for the live discrepancy alert panel.
NEXT_PUBLIC_POLL_INTERVAL_MS=15000
